@model ProductFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? $"Edit {Model.Name}" : "New loan product";
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Loan products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.Id.HasValue ? "Edit" : "New")</li>
    </ol>
</nav>
<div class="af-page-header"><h1 class="af-page-title">@ViewData["Title"]</h1></div>
<div class="card af-card">
    <div class="card-body">
        <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate class="row g-3">
            <div asp-validation-summary="All" class="alert alert-danger col-12"></div>
            <div class="col-md-2">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" />
                <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MinAmount" class="form-label"></label>
                <input asp-for="MinAmount" class="form-control text-end" type="number" step="0.01" />
                <span asp-validation-for="MinAmount" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MaxAmount" class="form-label"></label>
                <input asp-for="MaxAmount" class="form-control text-end" type="number" step="0.01" />
                <span asp-validation-for="MaxAmount" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="MinTenureMonths" class="form-label"></label>
                <input asp-for="MinTenureMonths" class="form-control text-end" type="number" />
                <span asp-validation-for="MinTenureMonths" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="MaxTenureMonths" class="form-label"></label>
                <input asp-for="MaxTenureMonths" class="form-control text-end" type="number" />
                <span asp-validation-for="MaxTenureMonths" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="DefaultInterestRate" class="form-label"></label>
                <input asp-for="DefaultInterestRate" class="form-control text-end" type="number" step="0.01" />
                <span asp-validation-for="DefaultInterestRate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">Active (offered for new applications)</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
