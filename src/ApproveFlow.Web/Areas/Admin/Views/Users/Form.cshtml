@model UserFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Edit {Model.FullName}" : "New user";
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.IsEdit ? "Edit" : "New")</li>
    </ol>
</nav>
<div class="af-page-header"><h1 class="af-page-title">@ViewData["Title"]</h1></div>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
    <input type="hidden" asp-for="ConcurrencyStamp" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="card af-card">
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        @if (Model.IsEdit)
                        {
                            <input asp-for="Email" class="form-control" readonly />
                        }
                        else
                        {
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                        }
                        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BranchId" class="form-label"></label>
                        <select asp-for="BranchId" class="form-select">
                            <option value="">Select…</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                        <span asp-validation-for="BranchId" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ApprovalLimit" class="form-label"></label>
                        <input asp-for="ApprovalLimit" class="form-control text-end" type="number" step="0.01" min="0" />
                        <div class="form-text">Required for Checkers. Above this amount a second checker must approve.</div>
                        <span asp-validation-for="ApprovalLimit" class="invalid-feedback d-block"></span>
                    </div>
                    <fieldset class="col-12">
                        <legend class="form-label fs-6">Roles</legend>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var role in AppRoles.All)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Roles" value="@role" id="role-@role" checked="@Model.Roles.Contains(role)" />
                                    <label class="form-check-label" for="role-@role">@role</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Roles" class="invalid-feedback d-block"></span>
                    </fieldset>
                    @if (Model.IsEdit)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" role="switch" />
                                <label asp-for="IsActive" class="form-check-label">Active (inactive users cannot sign in or use API tokens)</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label asp-for="TemporaryPassword" class="form-label"></label>
                            <input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" />
                            <div class="form-text">Min. 12 characters with upper, lower, digit and symbol.</div>
                            <span asp-validation-for="TemporaryPassword" class="invalid-feedback d-block"></span>
                        </div>
                    }
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card af-card">
                <div class="card-body small">
                    <h2 class="h6"><i class="bi bi-diagram-3 me-1"></i>Role guide</h2>
                    <dl class="mb-0">
                        <dt>Admin</dt><dd>Users, limits, branches, products, data migration.</dd>
                        <dt>Maker</dt><dd>Creates, edits and submits applications they own.</dd>
                        <dt>Checker</dt><dd>Approves within limit, rejects or returns. Never their own items.</dd>
                        <dt>Auditor</dt><dd>Read-only access to everything including the audit trail.</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
