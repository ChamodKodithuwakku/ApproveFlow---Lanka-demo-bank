<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for Windows hosting (shared ASP.NET hosts such as MonsterASP.NET / SmarterASP.NET, or Azure App Service
  on Windows). The .NET SDK fills in the aspNetCore element at publish time and keeps the sections below.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ApproveFlow.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <!-- Do not disclose the web server version; cap upload size (CSV migration files are at most 2 MB). -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="3145728" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
