<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation: ASP.NET Core MVC UI (cookie auth) and REST API v1 (JWT) in one host. -->
  <PropertyGroup>
    <RootNamespace>ApproveFlow.Web</RootNamespace>
    <UserSecretsId>approveflow-web-7d1c3a52-4b8e-4f0e-9a51-2c6f0f3b9e10</UserSecretsId>
    <!-- XML comments feed the Swagger/OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApproveFlow.Application\ApproveFlow.Application.csproj" />
    <ProjectReference Include="..\ApproveFlow.Infrastructure\ApproveFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Local configuration and runtime artefacts are never published or committed. -->
    <Content Update="appsettings.*.local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Example.json" CopyToPublishDirectory="Never" />
    <Content Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApproveFlow.Tests" />
  </ItemGroup>

</Project>
