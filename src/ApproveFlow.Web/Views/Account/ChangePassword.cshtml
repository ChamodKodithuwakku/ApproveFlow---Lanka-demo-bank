@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card af-card">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Change password</h2>
                <p class="text-muted small">Minimum 12 characters including upper-case, lower-case, a digit and a symbol.</p>
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-key me-1"></i>Update password</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
