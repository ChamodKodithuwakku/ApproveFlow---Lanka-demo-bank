@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_AuthLayout";
    }
}
<div class="af-empty-state">
    <i class="bi @(Model.StatusCode == 404 ? "bi-search" : Model.StatusCode == 403 ? "bi-shield-x" : "bi-exclamation-triangle")"></i>
    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.Message</p>
    @if (Model.ShowRequestId && Model.StatusCode >= 500)
    {
        <p class="small">Reference: <code>@Model.RequestId</code></p>
    }
    <a href="~/" class="btn btn-primary"><i class="bi bi-house me-1"></i>Go to dashboard</a>
</div>
