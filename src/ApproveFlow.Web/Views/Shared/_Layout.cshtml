@{
    var fullName = User.FindFirst(AppClaimTypes.FullName)?.Value ?? User.Identity?.Name ?? "User";
    var roles = AppRoles.All.Where(r => User.IsInRole(r)).ToList();
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · ApproveFlow</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="af-body">
    <a class="visually-hidden-focusable af-skip" href="#main">Skip to main content</a>
    <div class="af-shell">
        <aside class="af-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="afSidebar" aria-label="Main navigation">
            <div class="af-brand">
                <a asp-controller="Home" asp-action="Index" class="af-brand-link">
                    <partial name="_BrandMark" />
                    <span>
                        <span class="af-brand-name">ApproveFlow</span>
                        <span class="af-brand-org">Lanka Demo Bank</span>
                    </span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#afSidebar" aria-label="Close"></button>
            </div>

            <nav class="af-nav">
                <div class="af-nav-section">Workspace</div>
                <a class="af-nav-link @Nav.Active(ViewContext, "Home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
                <a class="af-nav-link @Nav.Active(ViewContext, "LoanApplications", "Index")" asp-area="" asp-controller="LoanApplications" asp-action="Index"><i class="bi bi-folder2-open"></i>Loan applications</a>
                @if (User.IsInRole(AppRoles.Maker))
                {
                    <a class="af-nav-link @Nav.Active(ViewContext, "LoanApplications", "Create")" asp-area="" asp-controller="LoanApplications" asp-action="Create"><i class="bi bi-plus-circle"></i>New application</a>
                }
                @if (User.IsInRole(AppRoles.Checker))
                {
                    <a class="af-nav-link @Nav.Active(ViewContext, "LoanApplications", "Queue")" asp-area="" asp-controller="LoanApplications" asp-action="Queue"><i class="bi bi-inbox"></i>Approval queue</a>
                }
                <a class="af-nav-link @Nav.Active(ViewContext, "Customers")" asp-area="" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>Customers</a>

                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Checker) || User.IsInRole(AppRoles.Auditor))
                {
                    <div class="af-nav-section">Oversight</div>
                    <a class="af-nav-link @Nav.Active(ViewContext, "Reports")" asp-area="" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Reports</a>
                }
                @if (User.IsInRole(AppRoles.Auditor))
                {
                    <a class="af-nav-link @Nav.Active(ViewContext, "AuditLogs")" asp-area="" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-shield-check"></i>Audit trail</a>
                }

                @if (User.IsInRole(AppRoles.Admin))
                {
                    <div class="af-nav-section">Administration</div>
                    <a class="af-nav-link @Nav.Active(ViewContext, "Users", area: "Admin")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i>Users &amp; limits</a>
                    <a class="af-nav-link @Nav.Active(ViewContext, "Branches", area: "Admin")" asp-area="Admin" asp-controller="Branches" asp-action="Index"><i class="bi bi-building"></i>Branches</a>
                    <a class="af-nav-link @Nav.Active(ViewContext, "Products", area: "Admin")" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>Loan products</a>
                    <a class="af-nav-link @Nav.Active(ViewContext, "DataImport", area: "Admin")" asp-area="Admin" asp-controller="DataImport" asp-action="Index"><i class="bi bi-cloud-arrow-up"></i>Data migration</a>
                }
            </nav>

            <div class="af-sidebar-footer">
                <i class="bi bi-clock"></i> Times shown in Asia/Colombo
            </div>
        </aside>

        <div class="af-main">
            <header class="af-topbar">
                <button class="btn af-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#afSidebar" aria-controls="afSidebar" aria-label="Open navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="af-topbar-title">@ViewData["Title"]</div>
                <div class="dropdown ms-auto">
                    <button class="btn af-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="af-avatar" aria-hidden="true">@initials</span>
                        <span class="d-none d-sm-inline text-start">
                            <span class="af-user-name">@fullName</span>
                            <span class="af-user-role">@string.Join(" · ", roles)</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><span class="dropdown-item-text small text-muted">@User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main id="main" class="af-content" tabindex="-1">
                <partial name="_Alerts" />
                @RenderBody()
            </main>

            <footer class="af-footer">
                <span>ApproveFlow 1.0 · Maker-checker loan approval</span>
                <span>Lanka Demo Bank is a fictional organisation used for demonstration only.</span>
            </footer>
        </div>
    </div>

    <partial name="_ConfirmModal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
