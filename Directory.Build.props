<Project>

  <!--
    Single place to choose the target framework for every project in the solution.
    Default: net10.0 (LTS). For a host that only offers .NET 8, build with
      dotnet build -p:ApproveFlowTargetFramework=net8.0
    or change the default below. Directory.Packages.props switches the Microsoft.* package
    versions automatically. Source code is kept at C# 12 so it compiles on both.
  -->
  <PropertyGroup>
    <ApproveFlowTargetFramework Condition="'$(ApproveFlowTargetFramework)' == ''">net10.0</ApproveFlowTargetFramework>
    <TargetFramework>$(ApproveFlowTargetFramework)</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>ApproveFlow</Product>
    <Company>Lanka Demo Bank (fictional organisation)</Company>
    <Copyright>Portfolio project. Lanka Demo Bank is fictional.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Code-quality gates: analyzers on, nullable and analyzer warnings fail Release builds. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- NuGet audit warnings are reported but must not break the build of a pinned dependency set. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
